                "variableref_value": null
              }
            ]
          }
        ]
      },
      "comment": ""
    },
    {
      "idRef": {
        "id": "9c79922a6e4834a21c18a8d4"
      },
      "index": 8,
      "text": "I now see that all of this was unavoidable once we became too big, to be looked upon as targets by the Harbingers, Taurians, [[DM.Factions[faction_MagistracyOfCanopus],Canopians]] or even the Successor States in the future.\n\nSo we will need to readjust our long-term goals accordingly for the Reach to survive.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 9,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9caba09883204c51df463cbf"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
