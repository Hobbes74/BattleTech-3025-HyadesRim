    },
    {
      "idRef": {
        "id": "9c5440d3d21793916c0d3603"
      },
      "index": 2,
      "text": "Strike, you dumbkofff? \n\nThat's the Harbinger command DropShip. You can't shoot it down no firepower, Princess.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 3,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9c1ea1ca6d514675c1209eb5"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
      "sourceTopicRef": null,
      "subjectTopicRefs": [],
      "sourceInSceneRef": null,
