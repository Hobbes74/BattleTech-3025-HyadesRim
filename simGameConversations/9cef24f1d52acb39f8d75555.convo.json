    {
      "idRef": {
        "id": "9c30ca227ebc00b47e6aad78"
      },
      "index": 2,
      "text": "Coromodir V is the most populous and rich planet of the Aurigan Reach, which makes it such a target for those Periphery marauders.\n\nThis also makes it challenging to defend because of the multitude of targets, although the presence of the <i>Argo</i> gives us a small tactical advantage to quickly redeploy the company.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 3,
          "hideIfUnavailable": true,
          "onlyOnce": false,
