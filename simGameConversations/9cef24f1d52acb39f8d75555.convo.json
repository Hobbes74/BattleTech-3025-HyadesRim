      "idRef": {
        "id": "9c81c61df2d0f28c904ace3b"
      },
      "index": 4,
      "text": "As needed... that is want we are here to avoid Captain Murray.\n\nJust say it Laura. what do you propose then? ",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 5,
          "hideIfUnavailable": true,
          "onlyOnce": false,
