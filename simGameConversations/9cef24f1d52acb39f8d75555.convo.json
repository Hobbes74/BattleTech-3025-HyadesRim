    {
      "idRef": {
        "id": "9c701acaab82efb423ec4aee"
      },
      "index": 7,
      "text": "No, that's what I saw them doing on Tortuga City, the Council of the Damned couldn't stop them back then because they thought they were just another pirate group. \n\nThen they just picked us one by one until we realized too long that this wasn't like anything we had faced. Sounds familar, <i>da</i>?",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 8,
          "hideIfUnavailable": true,
          "onlyOnce": false,
