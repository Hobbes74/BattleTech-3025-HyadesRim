    {
      "idRef": {
        "id": "9c5ecb5370a9b796e2de79c2"
      },
      "index": 1,
      "text": "I don't trust [[DM.Factions[faction_ComStar],ComStar]] so I sneaked myself into the mission as one of the Fusiliers and followed the [[DM.BaseDescriptionDefs[LoreComStarPrecentor],Precentor]] to the HPG control room.\n\nI learned at [[DM.BaseDescriptionDefs[LoreHellespont],Hellespont]] that their [[DM.BaseDescriptionDefs[LoreComStarExplorerCorps],Explorer Corps]] has a secret protocol for hostile encounters and that's what she really wanted to send back to Terra.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 2,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9c99da06b0c298f8468645db"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
      "sourceTopicRef": null,
      "subjectTopicRefs": [],
      "sourceInSceneRef": null,
