    {
      "idRef": {
        "id": "9cd126394a37699b48b98ae9"
      },
      "index": 3,
      "text": "That is quite the prize just for yourself, are you going to use your share to buy a BattleMech and become a [[DM.BaseDescriptionDefs[LoreMechWarrior],MechWarrior]] again?\n\nWe might have something to sell you if you are interested.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 4,
          "hideIfUnavailable": true,
