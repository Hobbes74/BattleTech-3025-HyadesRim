    {
      "idRef": {
        "id": "9c5242c9a4e8ade4ee467b57"
      },
      "index": 2,
      "text": "As agreed, twenty-five percent for me, five to the crew and another five percent already paid to the leaker inside [[DM.Factions[faction_MaglissSpirits],Magliss Spirits]].\n\nThat leaves the rest, ten million [[DM.BaseDescriptionDefs[LoreCBill],C-Bills]] to you, {COMPANY.CompanyName}, as agreed, and being loaded to your DropShip by your XO.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 3,
          "hideIfUnavailable": true,
          "onlyOnce": false,
