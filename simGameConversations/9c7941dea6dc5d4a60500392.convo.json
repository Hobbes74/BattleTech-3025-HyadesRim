    {
      "idRef": {
        "id": "9c1833e187c406fadbff2ef6"
      },
      "index": 1,
      "text": "Even weirder, did he really wanted to claim our heads to become immortal?\n\nYang, is this some Highlander ritual?",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 2,
          "hideIfUnavailable": true,
          "onlyOnce": false,
