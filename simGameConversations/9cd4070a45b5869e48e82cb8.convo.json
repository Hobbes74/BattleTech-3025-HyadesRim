    {
      "idRef": {
        "id": "9c3b59c98b371cc21f54ed85"
      },
      "index": 1,
      "text": "Count von Steffelbus didn't reveal any clue and neither did Duke Roberts give us any explanation to what [[DM.Factions[faction_InterconnectednessUnlimitedU],IU]] was doing on this world.\n\nWhatever the contents of that research base are, only [[DM.BaseDescriptionDefs[LoreHanseDavion],Hanse Davion]] and his minions know about it.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 2,
          "hideIfUnavailable": true,
          "onlyOnce": false,
