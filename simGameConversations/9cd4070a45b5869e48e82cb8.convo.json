      "comment": ""
    },
    {
      "idRef": {
        "id": "9ce3f4f2c60f9f045a70b8e7"
      },
      "index": 2,
      "text": "[[DM.BaseDescriptionDefs[LoreChandrasekharKurita],Bob]] and J'oral might know more about it but after we decided to ditch the [[DM.Factions[faction_SpreadingTheGloriesIncorporated],Spreading the Glories]] contract I doubt that they will trust us with that information.\n\nIt isn't something we should be worry about but I would be more concerned about [[DM.Factions[faction_Davion],Davion]] nobles fighting one another.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 3,
          "hideIfUnavailable": true,
          "onlyOnce": false,
