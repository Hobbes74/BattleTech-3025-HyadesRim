    {
      "idRef": {
        "id": "9cbc947fce385c5d88258506"
      },
      "index": 16,
      "text": "We will all remember that sight but no one knows the significance of what Captain Murray said and why it made the Harbingers stop their raid but both of them.\n\nThe official history of what took place it might be better not to include all the details of the story behind the Restoration, in order to let the horrors of the civil war to be forgotten.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 17,
          "hideIfUnavailable": true,
          "onlyOnce": false,
