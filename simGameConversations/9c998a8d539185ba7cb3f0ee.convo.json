    {
      "idRef": {
        "id": "9c25e9620026dde9440efb5c"
      },
      "index": 15,
      "text": "Possible but everyone still remembers how all of their 'Mechs boarded back their DropShips after recovering her ejection pod.\n\nAnd how up to that moment we all believed that she was acting out of deep revenge but instead she allowed herself to be captured by the Harbingers.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 16,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9cfc380ba5c7e0b17ffa3fc0"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
