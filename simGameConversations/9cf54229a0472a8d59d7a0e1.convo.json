    {
      "idRef": {
        "id": "9c5ac733c27d42c31f03cdf0"
      },
      "index": 1,
      "text": "I noticed the effects of withdrawal too among the Mech Techs.\n\nIn the old days we used to make 'space coffee' out of whatever we had at hand, let me just get my recipe book...",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 2,
          "hideIfUnavailable": true,
          "onlyOnce": false,
