    {
      "idRef": {
        "id": "9c1059c90d76f48aeef63c36"
      },
      "index": 7,
      "text": "According to the [[DM.BaseDescriptionDefs[LoreComStarPrecentor],Precentor]] they were coerced into making that report to trick us and the [[DM.BaseDescriptionDefs[LoreComStarFirstCircuit],First Circuit]] on [[DM.BaseDescriptionDefs[LoreTerra],Terra]].\n\nThen he managed to escape when the Harbingers started executing all the prisoners and has been hiding from them ever since.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 8,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9c1cc5e10f85f900b4797f5a"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
      "sourceTopicRef": null,
      "subjectTopicRefs": [],
      "sourceInSceneRef": null,
      "sourceWithTagInScene": "",
