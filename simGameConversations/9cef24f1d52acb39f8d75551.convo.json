    {
      "idRef": {
        "id": "9c739d897383fc69731b0050"
      },
      "index": 1,
      "text": "[[DM.BaseDescriptionDefs[LoreCordiaCity],Cordia City]] and the Royal Palace are still in our hands but the [[DM.BaseDescriptionDefs[LoreAranoRoyalGuard],Royal Guard]] has been ambushed while attempting to reinforce the Yards garrison.\n\nKamea is still alive and uninjured but her 'Mech has gone down and we need to send a search and rescue operation.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 2,
          "hideIfUnavailable": true,
          "onlyOnce": false,
