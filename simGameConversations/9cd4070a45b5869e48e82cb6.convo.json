    {
      "idRef": {
        "id": "9ca59535e84a4d68484d8117"
      },
      "index": 3,
      "text": "When we met in reality I was investigating a series of weird electromagnetic anomalies that begun in [[DM.BaseDescriptionDefs[LoreNewSyrtis],New Syrtis]] and then were reported in several other [[DM.BaseDescriptionDefs[LoreRimwardPeriphery],Rimward]] systems.\n\nUntil I was able to trace it back to [[DM.Factions[faction_InterconnectednessUnlimited],Interconnectedness Unlimited]] and this world.",
      "branches": [
        {
          "responseText": "We encountered IU while they were filming Davion propaganda.",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 4,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9c15283b4ce5966dc03be32a"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
      "sourceTopicRef": null,
      "subjectTopicRefs": [],
      "sourceInSceneRef": {
