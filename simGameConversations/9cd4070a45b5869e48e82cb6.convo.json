    {
      "idRef": {
        "id": "9cad8cfdd1e663c4deaf4cc6"
      },
      "index": 14,
      "text": "The 'null bomb' is the better choice for several events that might be related like [[DM.Factions[faction_ComStar],ComStar]] to issuing specific travel warnings for systems with reported K-F spikes, while users also reported technical delays in HPG messages.\n\nEven the toga boys can't hide when their services don't work if the whole galaxy depends on them daily.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 15,
          "hideIfUnavailable": true,
