    {
      "idRef": {
        "id": "9ca97af4a769b430fc3b8e8a"
      },
      "index": 17,
      "text": "And J'oral managed to have a private interview with Count Von Steffelbus where she gathered clues that IU has some rather secret projects going on this world.\n\nUnmarked and independent JumpShips have been watched coming and going, so there's definitely something down there.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 18,
