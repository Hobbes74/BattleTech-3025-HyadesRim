    {
      "idRef": {
        "id": "9c029dbbae043d2f4df487ed"
      },
      "index": 9,
      "text": "Tests of the weapon against single [[DM.BaseDescriptionDefs[LoreJumpShip],JumpShips]] and [[DM.BaseDescriptionDefs[LorePeriphery],Periphery]] systems is the most likely explanation for what is causing temporary blackouts and delays in travel and communications.\n\nAnd with the Fourth Succession War in progress, it seems this weapon has been deployed here, close to the undefended Liao-Periphery border.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 10,
