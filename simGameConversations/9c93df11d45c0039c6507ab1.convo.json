    {
      "idRef": {
        "id": "9cc27be24b224eef7c07e4b4"
      },
      "index": 1,
      "text": "Lady, how did you leave the DropShip?\n\nI somehow doubt you're just a journalist working for a Canopian wine maker.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 2,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9c6c07d21ee61abc2ffbe3c8"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
      "sourceTopicRef": null,
      "subjectTopicRefs": [],
      "sourceInSceneRef": null,
      "sourceWithTagInScene": "",
      "override_speaker": null,
      "speaker_override_id": "",
