    {
      "idRef": {
        "id": "9cc27be24b224eef7c07e4b4"
      },
      "index": 1,
      "text": "Why have I been locked up in one of the cabins? \n\nThis isn't quite the rescue I was expecting.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 2,
          "hideIfUnavailable": true,
          "onlyOnce": false,
