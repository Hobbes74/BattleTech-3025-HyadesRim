    {
      "idRef": {
        "id": "9c16113812ddae2cae32d083"
      },
      "index": 1,
      "text": "The data recovered indicates that's how the device was recovered and given to [[DM.Factions[faction_InterconnectednessUnlimited],IU]] for research but since they were forbidden to disassemble it, it was impossible to figure out how it operates or how to repair it.\n\nThe question he didn't answer was why it was deployed here, since it can't be used as a weapon if the device can't transmit.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 2,
          "hideIfUnavailable": true,
          "onlyOnce": false,
