    {
      "idRef": {
        "id": "9c8fecbe8eaad6654ed5c4a8"
      },
      "index": 1,
      "text": "Lady Marisol-Chaplin, we have removed the extremists, as you contracted us to do so, and the salvage recovered from their base proves that they were planning to increase their armed activities.\n\nAnd your initial intel was incorrect because we only found the Lone Wolves there.",
      "branches": [
        {
          "responseText": "And we weren't pleased to the unexpected opposition we faced.",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 2,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9cfa444b3da50c23a7546e12"
          },
