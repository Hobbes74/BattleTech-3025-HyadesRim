    {
      "idRef": {
        "id": "9c24305f485405086843b48d"
      },
      "index": 3,
      "text": "Our original orders didn't mention a full blown insurgent army, Lady Marisol.\n\nNor that you had already sent another company but that they had been decimated by the Lone Wolves before we defeated them.",
      "branches": [
        {
          "responseText": "",
