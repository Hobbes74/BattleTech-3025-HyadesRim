    {
      "idRef": {
        "id": "9c24305f485405086843b48d"
      },
      "index": 3,
      "text": "Our original orders didn't mention fighting a campaign against an insurgent army, Lady Marisol-Chaplin, and we will file a complain.\n\nPlus you willingly withheld information for us critical to the contract, when already had hired another company but that they had been decimated by the Lone Wolves.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 4,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9cf1f61c5760fbbbaf518196"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
      "sourceTopicRef": null,
      "subjectTopicRefs": [],
      "sourceInSceneRef": null,
      "sourceWithTagInScene": "",
      "override_speaker": null,
      "speaker_override_id": "598cd3f26230355c18000069",
      "actions": null,
      "comment": ""
    },
    {
      "idRef": {
        "id": "9cbe0c8d4e86da38ca34f50f"
      },
      "index": 4,
      "text": "The Lone Wolves are vultures and they will not be tolerated in the Concordat.\n\nIf you believe that the [[DM.BaseDescriptionDefs[LoreMercenaryReviewBoard],MRB]] will side over you over such <i>bandidos</i>, you have jumped too close to the [[DM.BaseDescriptionDefs[LoreTheSwansEye],Swan's Eye]], <i>si</i>?.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 5,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9ccf5bf93c034564f7eb67c1"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
      "sourceTopicRef": null,
      "subjectTopicRefs": [],
      "sourceInSceneRef": null,
      "sourceWithTagInScene": "",
      "override_speaker": null,
      "speaker_override_id": "59b98acf623035ac140056da",
      "actions": null,
      "comment": ""
    },
    {
      "idRef": {
        "id": "9ca159784feb455a63ff5c4f"
      },
      "index": 5,
      "text": "That is not all the evidence we have, Lady Marisol, but we will be more than happy to discuss this at [[DM.BaseDescriptionDefs[LoreHellespont],Hellespont]] with the local ComStar office and seek mediation.\n\nOr we can also report this matter to the Ministry of Trade and Colonization at [[DM.BaseDescriptionDefs[LoreTaurus],Taurus]]...",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 6,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9c34190a754e1bfa4be95148"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
