    {
      "idRef": {
        "id": "9c095980935557a6ff69fda8"
      },
      "index": 2,
      "text": "You received enough information to perform your task, mercenary. \n\nWe couldn't anticipate that the Inheritors would have been so far ahead in their recruitment and training, so you mercenaries will need to keep hitting them.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 3,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9c4401bba9a8c37658433881"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
      "sourceTopicRef": null,
      "subjectTopicRefs": [],
      "sourceInSceneRef": null,
      "sourceWithTagInScene": "",
