      "idRef": {
        "id": "9cbe0c8d4e86da38ca34f50f"
      },
      "index": 4,
      "text": "The Lone Wolves are nothing more than a myth and those kind of vultures are not tolerated anymore in the Concordat.\n\nIf you believe that the MRB will side over you because of the testimony of such <i>bandidos</i>, you have jumped too close to the Swan's Eye.",
      "branches": [
