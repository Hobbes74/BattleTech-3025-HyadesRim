      "text": "{COMMANDER.FirstName} and the rest of the company had assumed we would be more on active role to oppose the Harbinger landings.\n\nWe must be the best equipped unit in this entire army since we are packing a ton of [[DM.BaseDescriptionDefs[LoreLosTech],lostech]].",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 16,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9cf6167b97a358ded03d09e5"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
