    {
      "idRef": {
        "id": "9c4b21163421c6a3dccd3c41"
      },
      "index": 1,
      "text": "Well, we all saw the Harbingers blowing up her 'Mech's cockpit as a reply but our forces didn't recover her body or any remains from the landing zone or her personal 'Mech.\n\nEither they took it when they left or she managed to escape somehow.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 2,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9c4f54fb684a255b258f8278"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
