      "speaker_override_id": "598cd3f36230355c1800006a",
      "actions": null,
      "comment": ""
    },
    {
      "idRef": {
        "id": "9c2d897f341b14c58caabd18"
      },
      "index": 14,
      "text": "A lot of my Kitten MechWarriors have gone dispossessed, we can help you getting the 'Mechs ready, Chief Virtanen.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
