      "comment": ""
    },
    {
      "idRef": {
        "id": "9c5440d3d21793916c0d3603"
      },
      "index": 2,
      "text": "Strike what four eyes? \n\nThat's the Harbinger command DropShip, you can't shoot it down no firepower left for that, you <i>idiot</i>.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 3,
          "hideIfUnavailable": true,
          "onlyOnce": false,
