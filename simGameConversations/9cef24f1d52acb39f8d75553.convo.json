    {
      "idRef": {
        "id": "9c6cc8838d116b2a8fa5ef8c"
      },
      "index": 9,
      "text": "And I won't Farah, that is why I ordered you to regain the starport. \n\nIf the Harbingers don't leave after this decapitation strike, you must evacuate and save as many as possible from Coromodir.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 10,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9c39fa87f8eeade54aeccd40"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
      "sourceTopicRef": null,
      "subjectTopicRefs": [],
      "sourceInSceneRef": null,
      "sourceWithTagInScene": "",
