    {
      "idRef": {
        "id": "9c6b0f758ebd581195e02714"
      },
      "index": 3,
      "text": "This has been an unguarded sector since D-Day, that's why they have been using it since the initial invasion.\n\nAnd it also makes it perfect to slip a couple of 'Mechs undetected into their landing zone.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 4,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9c0958bad0458c607a9ce86d"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
      "sourceTopicRef": null,
      "subjectTopicRefs": [],
      "sourceInSceneRef": null,
      "sourceWithTagInScene": "",
      "override_speaker": null,
      "speaker_override_id": "59b97f45623035ac140054ca",
      "actions": null,
      "comment": ""
