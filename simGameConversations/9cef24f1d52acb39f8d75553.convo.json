    {
      "idRef": {
        "id": "9c439fdf1363a02a1146f10e"
      },
      "index": 8,
      "text": "You can't be ordering more nuclear strikes later Kamea, unless you want to literally 'salt the earth' and make the entire city unhabitable!\n\nWe are already talking about a ground burst with all of the corresponding increase in nuclear fallout.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 9,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9c7fff0e65719e248f8370ac"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
      "sourceTopicRef": null,
      "subjectTopicRefs": [],
      "sourceInSceneRef": null,
      "sourceWithTagInScene": "",
      "override_speaker": null,
      "speaker_override_id": "59b98a97623035ac140056c6",
      "actions": {
        "ops": [
          {
            "functionName": "Set BattleTech Camera Lock",
