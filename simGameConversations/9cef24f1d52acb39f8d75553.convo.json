    {
      "idRef": {
        "id": "9c6731eaff26d8062f5b7f7c"
      },
      "index": 1,
      "text": "Based on their ground movements, their landing zone will be next to Shepard's Pass, which might give us an opportunity to strike at what we assume is their leadership based on signals intercepted by the <i>Argo</i>.\n\nIf we can perform a decapitation strike, that might give us more time before....",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 2,
          "hideIfUnavailable": true,
          "onlyOnce": false,
