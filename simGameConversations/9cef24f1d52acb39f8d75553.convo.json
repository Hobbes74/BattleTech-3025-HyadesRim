      "speaker_override_id": "",
      "actions": null,
      "comment": ""
    },
    {
      "idRef": {
        "id": "9c269719217868ea32b0a3aa"
      },
      "index": 2,
      "text": "Which is even more astonishing, of how they simply stopped their attack on Cardia City and the Royal Palace and just pack it up and leave.\n\nWhat did she say and why it had the effect of stopping the Harbingers is another of the mysteries behind this invasion.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 3,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9c5ab6944d5cda622fd18eb6"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
      "sourceTopicRef": null,
      "subjectTopicRefs": [],
      "sourceInSceneRef": null,
      "sourceWithTagInScene": "",
