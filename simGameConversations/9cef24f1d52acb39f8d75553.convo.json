    {
      "idRef": {
        "id": "9c9501f48955e55f55e13e65"
      },
      "index": 4,
      "text": "A pair of 'Mechs?\n\nWhat will that achieve?",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 5,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9c85cb4ceb174be0b5e4640a"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
      "sourceTopicRef": null,
      "subjectTopicRefs": [],
      "sourceInSceneRef": null,
      "sourceWithTagInScene": "",
      "override_speaker": null,
      "speaker_override_id": "598cd3f36230355c1800006a",
      "actions": {
        "ops": [
          {
            "functionName": "Set BattleTech Viewscreen Image",
            "args": [
              {
                "int_value": 0,
                "bool_value": false,
                "float_value": 0.0,
                "string_value": "axylus",
                "call_value": null,
                "variableref_value": null
              }
            ]
          }
        ]
      },
      "comment": ""
