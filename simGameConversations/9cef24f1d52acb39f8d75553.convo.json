    {
      "idRef": {
        "id": "9ca9a2e01b8fa025d357647a"
      },
      "index": 5,
      "text": "Well, for the part that matters... we won, the Harbingers have retreated and the Restoration is safe for now.\n\nPerhaps now we can finally have peace.",
      "branches": [
        {
          "responseText": "",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 6,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "9cd34e2dc2b9da6a7808a889"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        }
      ],
      "nodeType": 1,
      "truthValue": false,
      "autoFollowBranchDelay": 1,
      "inputMaxLength": 0,
      "sourceTopicRef": null,
      "subjectTopicRefs": [],
      "sourceInSceneRef": null,
      "sourceWithTagInScene": "",
      "override_speaker": null,
