    {
      "idRef": {
        "id": "9c055398fa6b66161910b5b5"
      },
      "index": 15,
      "text": "Very well, we could use the help we can get.\n\nCommander get ready, this might be our final mission... ever.",
      "branches": [
        {
          "responseText": "All the way until the end, Lady Arano.",
          "conditions": null,
